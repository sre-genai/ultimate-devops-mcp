# ============================================================================
# Ultimate DevOps MCP — configuration
# Every integration is OPTIONAL: it activates only when its env vars are set.
# Copy to .env and fill in what you use.
# ============================================================================

# ---- Server ----------------------------------------------------------------
# Loopback by default (not network-exposed). Set 0.0.0.0 to expose deliberately
# — only behind MCP_AUTH_TOKEN + network policy. (The Docker image sets 0.0.0.0.)
# MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=8080
# Bearer token clients must send as "Authorization: Bearer <token>".
# STRONGLY recommended, and REQUIRED if you expose the server. Generate: openssl rand -hex 32
MCP_AUTH_TOKEN=
# Enable mutating tools (SQL writes, kafka produce, k8s scale, argocd sync, ...)
MCP_ALLOW_WRITES=false
LOG_LEVEL=info
MCP_RATE_LIMIT_PER_MINUTE=300
MCP_SESSION_IDLE_TIMEOUT_MINUTES=30
MCP_MAX_RESULT_CHARS=50000
# Set true when running behind a reverse proxy / load balancer
MCP_TRUST_PROXY=false

# ---- Postgres ---------------------------------------------------------------
# POSTGRES_URL=postgres://user:pass@localhost:5432/mydb   # DB in the URL is the default;
#                                                         # tools can target any DB on the
#                                                         # instance via a `database` arg
#                                                         # (see postgres_list_databases).
# POSTGRES_PGBOUNCER=true            # connecting through PgBouncer (transaction/statement
#                                    # pool mode): skips the server statement_timeout param
# POSTGRES_MAX_DB_POOLS=8            # max distinct databases kept warm at once (LRU-capped)
# POSTGRES_POOL_MAX=3                # connections per database pool
# POSTGRES_DB_ALLOW=analytics,/development/,/qa/i   # restrict which DBs are listable/targetable:
#                                    # comma-separated exact names and/or /regex/ (substring;
#                                    # add i for case-insensitive). Enforced on
#                                    # postgres_list_databases AND the `database` arg.
#                                    # Unset = all databases allowed.

# ---- MongoDB ----------------------------------------------------------------
# MONGODB_URI=mongodb://user:pass@localhost:27017

# ---- Neo4j ------------------------------------------------------------------
# NEO4J_URL=neo4j://localhost:7687
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=
# NEO4J_DATABASE=neo4j

# ---- Elasticsearch / OpenSearch ----------------------------------------------
# ELASTICSEARCH_NODE=https://localhost:9200
# ELASTICSEARCH_API_KEY=            # either API key...
# ELASTICSEARCH_USERNAME=           # ...or basic auth
# ELASTICSEARCH_PASSWORD=

# ---- Kafka -------------------------------------------------------------------
# KAFKA_BROKERS=localhost:9092,localhost:9093
# KAFKA_CLIENT_ID=ultimate-devops-mcp
# KAFKA_SSL=false
# KAFKA_SASL_MECHANISM=             # plain | scram-sha-256 | scram-sha-512
# KAFKA_SASL_USERNAME=
# KAFKA_SASL_PASSWORD=

# ---- Redis -------------------------------------------------------------------
# REDIS_URL=redis://localhost:6379

# ---- Kubernetes ---------------------------------------------------------------
# Uses default kubeconfig resolution (~/.kube/config or in-cluster service account)
# K8S_ENABLED=true
# KUBECONFIG=/path/to/kubeconfig

# ---- Grafana -------------------------------------------------------------------
# Single instance:
# GRAFANA_URL=https://grafana.example.com
# GRAFANA_TOKEN=                    # service account token
#
# Multiple instances (e.g. prod + non-prod) — declare names, then a URL+TOKEN
# pair per name. Tools take an optional `instance` arg (default: first listed,
# or GRAFANA_PRIMARY). A bare GRAFANA_URL above still works as "default".
# GRAFANA_INSTANCES=prod,nonprod
# GRAFANA_PROD_URL=https://grafana.prod.example.com
# GRAFANA_PROD_TOKEN=
# GRAFANA_NONPROD_URL=https://grafana.staging.example.com
# GRAFANA_NONPROD_TOKEN=
# GRAFANA_PRIMARY=prod             # optional; which instance is the default

# ---- Datadog -------------------------------------------------------------------
# DATADOG_API_KEY=
# DATADOG_APP_KEY=
# DATADOG_SITE=datadoghq.com        # or datadoghq.eu, us3.datadoghq.com, ...

# ---- Prometheus -----------------------------------------------------------------
# PROMETHEUS_URL=http://localhost:9090
# PROMETHEUS_BEARER_TOKEN=

# ---- ArgoCD --------------------------------------------------------------------
# ARGOCD_URL=https://argocd.example.com
# ARGOCD_TOKEN=                     # argocd account generate-token

# ---- GitLab --------------------------------------------------------------------
# GITLAB_TOKEN=                     # personal/project access token (api scope)
# GITLAB_URL=https://gitlab.com     # or your self-hosted instance

# ---- GitHub --------------------------------------------------------------------
# GITHUB_TOKEN=                     # fine-grained or classic PAT
# GITHUB_API_URL=https://api.github.com   # for GitHub Enterprise: https://ghe.example.com/api/v3

# ---- Bitbucket (Cloud API 2.0) -------------------------------------------------
# BITBUCKET_TOKEN=                  # repository/workspace access token (Bearer), OR:
# BITBUCKET_USERNAME=               # username + app password (Basic auth)
# BITBUCKET_APP_PASSWORD=
# BITBUCKET_WORKSPACE=              # default workspace (so tools can omit it)
# BITBUCKET_API_URL=https://api.bitbucket.org/2.0

# ---- Jira (Cloud or Server/Data Center; single or multi-instance) ---------------
# Cloud  → URL + EMAIL + API_TOKEN (basic auth, REST v3)
# Server → URL + TOKEN             (bearer PAT, REST v2)
# JIRA_URL=https://yourco.atlassian.net
# JIRA_EMAIL=you@yourco.com
# JIRA_API_TOKEN=                   # Atlassian API token (Cloud)
# JIRA_TOKEN=                       # personal access token (Server/DC) — use instead of EMAIL+API_TOKEN
#
# Multiple instances (e.g. prod + sandbox): declare names, then a set per name.
# Tools take an optional `instance` arg (default: first listed, or JIRA_PRIMARY).
# JIRA_INSTANCES=prod,sandbox
# JIRA_PROD_URL=https://yourco.atlassian.net
# JIRA_PROD_EMAIL=you@yourco.com
# JIRA_PROD_API_TOKEN=
# JIRA_SANDBOX_URL=https://jira.sandbox.internal
# JIRA_SANDBOX_TOKEN=
# JIRA_PRIMARY=prod

# ---- Playwright (browser tools) ---------------------------------------------------
# Requires: npx playwright install chromium  (or WITH_BROWSER=true Docker build)
# PLAYWRIGHT_ENABLED=true
# PLAYWRIGHT_NO_SANDBOX=true        # required inside most containers

# ---- MCP federation (front other MCP servers) -------------------------------------
# Re-expose the tools of other Streamable-HTTP MCP servers through this one's /mcp
# endpoint, namespaced as `<name>__<remoteTool>`. Declare the servers, then a URL
# (required) and optional bearer token per name. Unreachable servers are skipped at
# startup — they never block boot.
# MCP_FEDERATE=payments,search
# MCP_FEDERATE_PAYMENTS_URL=https://payments-mcp.internal/mcp
# MCP_FEDERATE_PAYMENTS_TOKEN=      # sent as Authorization: Bearer <token> (optional)
# MCP_FEDERATE_SEARCH_URL=https://search-mcp.internal/mcp
# MCP_FEDERATE_SEARCH_TOKEN=
