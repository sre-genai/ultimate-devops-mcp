# ============================================================================
# Ultimate DevOps MCP — configuration
# Every integration is OPTIONAL: it activates only when its env vars are set.
# Copy to .env and fill in what you use.
# ============================================================================

# ---- Server ----------------------------------------------------------------
# Loopback by default (not network-exposed). Set 0.0.0.0 to expose deliberately
# — only behind MCP_AUTH_TOKEN + network policy. (The Docker image sets 0.0.0.0.)
# MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=8080
# Bearer token clients must send as "Authorization: Bearer <token>".
# STRONGLY recommended, and REQUIRED if you expose the server. Generate: openssl rand -hex 32
# This is a single FULL-ACCESS key. For per-caller scopes, use MCP_API_KEYS below.
MCP_AUTH_TOKEN=
# Scoped API keys (optional): JSON mapping each token secret -> scope
#   { "<secret>": { "name": <label>, "tools"?: [<allowlist>], "allowWrites"?: <bool> } }
# "tools" omitted = all tools. Presented bearer is matched constant-time against
# MCP_AUTH_TOKEN and every entry; unknown token -> 401. Every call is audited.
# MCP_API_KEYS={"tok_ci":{"name":"ci","tools":["postgres_query","prometheus_query"],"allowWrites":false},"tok_oncall":{"name":"oncall","allowWrites":true}}
# Enable mutating tools (SQL writes, kafka produce, k8s scale, argocd sync, ...)
MCP_ALLOW_WRITES=false
# Dry-run: write/mutating tools return a preview of what WOULD happen and touch
# no backend. Read tools are unaffected. Great for rehearsing changes safely.
MCP_WRITE_DRYRUN=false
LOG_LEVEL=info
MCP_RATE_LIMIT_PER_MINUTE=300
MCP_SESSION_IDLE_TIMEOUT_MINUTES=30
MCP_MAX_RESULT_CHARS=50000
# Set true when running behind a reverse proxy / load balancer
MCP_TRUST_PROXY=false

# ---- Outbound egress proxy -----------------------------------------------------
# When set (any case), all outbound HTTP/REST calls (Grafana, Datadog, Prometheus,
# ArgoCD, GitLab, GitHub, Bitbucket, Jira) are routed through the proxy. NO_PROXY
# is honored. NOTE: the database drivers, Elasticsearch, Kubernetes and Playwright
# use their own transports and are NOT routed through this proxy.
# HTTP_PROXY=http://proxy.internal:3128
# HTTPS_PROXY=http://proxy.internal:3128
# NO_PROXY=localhost,127.0.0.1,.internal

# ---- Postgres ---------------------------------------------------------------
# POSTGRES_URL=postgres://user:pass@localhost:5432/mydb   # DB in the URL is the default;
#                                                         # tools can target any DB on the
#                                                         # instance via a `database` arg
#                                                         # (see postgres_list_databases).
# POSTGRES_PGBOUNCER=true            # connecting through PgBouncer (transaction/statement
#                                    # pool mode): skips the server statement_timeout param
# POSTGRES_MAX_DB_POOLS=8            # max distinct databases kept warm at once (LRU-capped)
# POSTGRES_POOL_MAX=3                # connections per database pool
# POSTGRES_DB_ALLOW=analytics,/development/,/qa/i   # restrict which DBs are listable/targetable:
#                                    # comma-separated exact names and/or /regex/ (substring;
#                                    # add i for case-insensitive). Enforced on
#                                    # postgres_list_databases AND the `database` arg.
#                                    # Unset = all databases allowed.

# ---- MongoDB ----------------------------------------------------------------
# MONGODB_URI=mongodb://user:pass@localhost:27017

# ---- Neo4j ------------------------------------------------------------------
# NEO4J_URL=neo4j://localhost:7687
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=
# NEO4J_DATABASE=neo4j

# ---- Elasticsearch / OpenSearch ----------------------------------------------
# ELASTICSEARCH_NODE=https://localhost:9200
# ELASTICSEARCH_API_KEY=            # either API key...
# ELASTICSEARCH_USERNAME=           # ...or basic auth
# ELASTICSEARCH_PASSWORD=
#
# Multiple instances: declare names, then a NODE (+ auth) per name. Tools take an
# optional `instance` arg (default: first listed, or ELASTICSEARCH_PRIMARY). A
# bare ELASTICSEARCH_NODE above still works as "default".
# ELASTICSEARCH_INSTANCES=prod,staging
# ELASTICSEARCH_PROD_NODE=https://es.prod.example.com:9200
# ELASTICSEARCH_PROD_API_KEY=
# ELASTICSEARCH_STAGING_NODE=https://es.staging.example.com:9200
# ELASTICSEARCH_STAGING_USERNAME=
# ELASTICSEARCH_STAGING_PASSWORD=
# ELASTICSEARCH_PRIMARY=prod

# ---- Kafka -------------------------------------------------------------------
# KAFKA_BROKERS=localhost:9092,localhost:9093
# KAFKA_CLIENT_ID=ultimate-devops-mcp
# KAFKA_SSL=false
# KAFKA_SASL_MECHANISM=             # plain | scram-sha-256 | scram-sha-512
# KAFKA_SASL_USERNAME=
# KAFKA_SASL_PASSWORD=

# ---- Redis -------------------------------------------------------------------
# REDIS_URL=redis://localhost:6379

# ---- Kubernetes ---------------------------------------------------------------
# Uses default kubeconfig resolution (~/.kube/config or in-cluster service account)
# K8S_ENABLED=true
# KUBECONFIG=/path/to/kubeconfig

# ---- Grafana -------------------------------------------------------------------
# Single instance:
# GRAFANA_URL=https://grafana.example.com
# GRAFANA_TOKEN=                    # service account token
#
# Multiple instances (e.g. prod + non-prod) — declare names, then a URL+TOKEN
# pair per name. Tools take an optional `instance` arg (default: first listed,
# or GRAFANA_PRIMARY). A bare GRAFANA_URL above still works as "default".
# GRAFANA_INSTANCES=prod,nonprod
# GRAFANA_PROD_URL=https://grafana.prod.example.com
# GRAFANA_PROD_TOKEN=
# GRAFANA_NONPROD_URL=https://grafana.staging.example.com
# GRAFANA_NONPROD_TOKEN=
# GRAFANA_PRIMARY=prod             # optional; which instance is the default

# All of the HTTP integrations below support the same multi-instance convention:
# set <NAME>_INSTANCES=a,b then a per-instance set of vars (<NAME>_A_…, <NAME>_B_…).
# Tools gain an optional `instance` arg (default: first listed, or <NAME>_PRIMARY),
# and the single-instance vars still work as "default".

# ---- Datadog -------------------------------------------------------------------
# DATADOG_API_KEY=
# DATADOG_APP_KEY=
# DATADOG_SITE=datadoghq.com        # or datadoghq.eu, us3.datadoghq.com, ...
#
# Multiple instances:
# DATADOG_INSTANCES=prod,eu
# DATADOG_PROD_API_KEY=
# DATADOG_PROD_APP_KEY=
# DATADOG_EU_API_KEY=
# DATADOG_EU_APP_KEY=
# DATADOG_EU_SITE=datadoghq.eu
# DATADOG_PRIMARY=prod

# ---- Prometheus -----------------------------------------------------------------
# PROMETHEUS_URL=http://localhost:9090
# PROMETHEUS_BEARER_TOKEN=
#
# Multiple instances:
# PROMETHEUS_INSTANCES=prod,staging
# PROMETHEUS_PROD_URL=https://prometheus.prod.example.com
# PROMETHEUS_PROD_BEARER_TOKEN=
# PROMETHEUS_STAGING_URL=https://prometheus.staging.example.com
# PROMETHEUS_PRIMARY=prod

# ---- ArgoCD --------------------------------------------------------------------
# ARGOCD_URL=https://argocd.example.com
# ARGOCD_TOKEN=                     # argocd account generate-token
#
# Multiple instances:
# ARGOCD_INSTANCES=prod,staging
# ARGOCD_PROD_URL=https://argocd.prod.example.com
# ARGOCD_PROD_TOKEN=
# ARGOCD_STAGING_URL=https://argocd.staging.example.com
# ARGOCD_STAGING_TOKEN=
# ARGOCD_PRIMARY=prod

# ---- GitLab --------------------------------------------------------------------
# GITLAB_TOKEN=                     # personal/project access token (api scope)
# GITLAB_URL=https://gitlab.com     # or your self-hosted instance
#
# Multiple instances:
# GITLAB_INSTANCES=cloud,onprem
# GITLAB_CLOUD_TOKEN=
# GITLAB_ONPREM_TOKEN=
# GITLAB_ONPREM_URL=https://gitlab.internal
# GITLAB_PRIMARY=cloud

# ---- GitHub --------------------------------------------------------------------
# GITHUB_TOKEN=                     # fine-grained or classic PAT
# GITHUB_API_URL=https://api.github.com   # for GitHub Enterprise: https://ghe.example.com/api/v3
#
# Multiple instances:
# GITHUB_INSTANCES=cloud,ghe
# GITHUB_CLOUD_TOKEN=
# GITHUB_GHE_TOKEN=
# GITHUB_GHE_API_URL=https://ghe.example.com/api/v3
# GITHUB_PRIMARY=cloud

# ---- Bitbucket (Cloud API 2.0) -------------------------------------------------
# BITBUCKET_TOKEN=                  # repository/workspace access token (Bearer), OR:
# BITBUCKET_USERNAME=               # username + app password (Basic auth)
# BITBUCKET_APP_PASSWORD=
# BITBUCKET_WORKSPACE=              # default workspace (so tools can omit it)
# BITBUCKET_API_URL=https://api.bitbucket.org/2.0
#
# Multiple instances:
# BITBUCKET_INSTANCES=prod,sandbox
# BITBUCKET_PROD_TOKEN=
# BITBUCKET_PROD_WORKSPACE=
# BITBUCKET_SANDBOX_USERNAME=
# BITBUCKET_SANDBOX_APP_PASSWORD=
# BITBUCKET_PRIMARY=prod

# ---- Jira (Cloud or Server/Data Center; single or multi-instance) ---------------
# Cloud  → URL + EMAIL + API_TOKEN (basic auth, REST v3)
# Server → URL + TOKEN             (bearer PAT, REST v2)
# JIRA_URL=https://yourco.atlassian.net
# JIRA_EMAIL=you@yourco.com
# JIRA_API_TOKEN=                   # Atlassian API token (Cloud)
# JIRA_TOKEN=                       # personal access token (Server/DC) — use instead of EMAIL+API_TOKEN
#
# Multiple instances (e.g. prod + sandbox): declare names, then a set per name.
# Tools take an optional `instance` arg (default: first listed, or JIRA_PRIMARY).
# JIRA_INSTANCES=prod,sandbox
# JIRA_PROD_URL=https://yourco.atlassian.net
# JIRA_PROD_EMAIL=you@yourco.com
# JIRA_PROD_API_TOKEN=
# JIRA_SANDBOX_URL=https://jira.sandbox.internal
# JIRA_SANDBOX_TOKEN=
# JIRA_PRIMARY=prod

# ---- Playwright (browser tools) ---------------------------------------------------
# Requires: npx playwright install chromium  (or WITH_BROWSER=true Docker build)
# PLAYWRIGHT_ENABLED=true
# PLAYWRIGHT_NO_SANDBOX=true        # required inside most containers

# ---- MCP federation (front other MCP servers) -------------------------------------
# Re-expose the tools of other Streamable-HTTP MCP servers through this one's /mcp
# endpoint, namespaced as `<name>__<remoteTool>`. Declare the servers, then a URL
# (required) and optional bearer token per name. Unreachable servers are skipped at
# startup — they never block boot.
# MCP_FEDERATE=payments,search
# MCP_FEDERATE_PAYMENTS_URL=https://payments-mcp.internal/mcp
# MCP_FEDERATE_PAYMENTS_TOKEN=      # sent as Authorization: Bearer <token> (optional)
# MCP_FEDERATE_SEARCH_URL=https://search-mcp.internal/mcp
# MCP_FEDERATE_SEARCH_TOKEN=

# ---- PagerDuty (REST API v2) ----------------------------------------------------
# PAGERDUTY_API_TOKEN=              # REST API token (read/write per token scope)
# PAGERDUTY_FROM_EMAIL=            # a valid user email; required to create/modify incidents
# PAGERDUTY_API_URL=https://api.pagerduty.com   # or https://api.eu.pagerduty.com

# ---- Sentry --------------------------------------------------------------------
# SENTRY_TOKEN=                     # auth token (project:read, event:read, ...)
# SENTRY_ORG=                       # organization slug
# SENTRY_URL=https://sentry.io      # self-hosted: https://sentry.example.com

# ---- Jenkins (basic auth) ------------------------------------------------------
# JENKINS_URL=https://jenkins.example.com
# JENKINS_USER=                     # username
# JENKINS_TOKEN=                    # API token (User > Configure > API Token)

# ---- Slack ---------------------------------------------------------------------
# SLACK_BOT_TOKEN=                  # xoxb-... (channels:read, channels:history, chat:write).
#                                   # slack_search needs a user token with search:read.

# ---- Vault (read-mostly, KV v2) ------------------------------------------------
# VAULT_ADDR=https://vault.example.com:8200
# VAULT_TOKEN=                      # token with read/list on the KV paths you use
# VAULT_KV_MOUNT=secret             # default KV v2 mount for the secret tools

# ---- Pinecone (vector database) ------------------------------------------------
# PINECONE_API_KEY=                 # project API key
# PINECONE_API_VERSION=2024-07      # X-Pinecone-API-Version header (optional)

# ---- Kubecost (Kubernetes cost, read-only) -------------------------------------
# KUBECOST_URL=http://kubecost-cost-analyzer.kubecost:9090
# KUBECOST_TOKEN=                   # optional bearer token if your install requires one

# ---- Docker engine -------------------------------------------------------------
# Talks to the local daemon over its unix socket, or a plain-HTTP tcp:// DOCKER_HOST.
# DOCKER_ENABLED=true               # use the default socket /var/run/docker.sock
# DOCKER_SOCKET=/var/run/docker.sock
# DOCKER_HOST=tcp://127.0.0.1:2375  # alternative: remote daemon (no TLS)
#   Inside a container, mount the socket: -v /var/run/docker.sock:/var/run/docker.sock

# ---- Helm releases (read-only) -------------------------------------------------
# Reads Helm 3 release Secrets through the Kubernetes API (same cluster as k8s tools).
# HELM_ENABLED=true
# KUBECONFIG=/path/to/kubeconfig    # optional; default resolution used when unset

# ---- Trivy (vulnerability scanner) ---------------------------------------------
# Runs the local `trivy` binary; it must be installed and on PATH (or set TRIVY_BIN).
# TRIVY_ENABLED=true
# TRIVY_BIN=trivy
# TRIVY_TIMEOUT_SECONDS=120

# ---- SonarQube (code quality & security) ---------------------------------------
# SONARQUBE_URL=https://sonarqube.example.com
# SONARQUBE_TOKEN=                  # user token (used as the basic-auth username)

# ---- Native OIDC / JWT auth (SSO) ----------------------------------------------
# Validate IdP-issued bearer JWTs (Cognito, Auth0, Azure Entra, Google, Keycloak)
# against the issuer's JWKS. Works ALONGSIDE MCP_AUTH_TOKEN / MCP_API_KEYS (those
# are tried first). Claims map to the same scope model: adminGroups → allowWrites,
# and an optional group→tools allowlist. Set the issuer + (recommended) audience;
# the JWKS is discovered from the issuer automatically.
# AUTH_OIDC_ISSUER=https://your-tenant.auth0.com/
# AUTH_OIDC_AUDIENCE=udm-api
# AUTH_OIDC_NAME_CLAIM=email          # claim used as the audit identity (default email → sub)
# AUTH_OIDC_GROUPS_CLAIM=groups       # cognito:groups | roles | permissions (per IdP)
# AUTH_OIDC_ADMIN_GROUPS=devops-admins,sre    # groups granted write access
# AUTH_OIDC_GROUP_TOOLS={"readers":["postgres_query","prom_query"]}  # optional per-group allowlist
# AUTH_OIDC_ALGS=RS256                 # accepted signing algorithms
# AUTH_OIDC_JWKS_URI=                  # optional; only if discovery is unavailable
#
# Issuer presets:
#   AWS Cognito : https://cognito-idp.<region>.amazonaws.com/<userPoolId>   groups claim: cognito:groups
#   Auth0       : https://<tenant>.auth0.com/                                groups claim: permissions (or a namespaced claim)
#   Azure Entra : https://login.microsoftonline.com/<tenantId>/v2.0         groups claim: roles (or groups)
#   Google      : https://accounts.google.com                               name claim: email

# ---- Self-service API-key console ----------------------------------------------
# A web console where a human signs in via SSO (OIDC authorization-code flow) and
# mints/revokes their OWN scoped API keys. Keys are stored hashed and verified on
# the /mcp bearer path like any other key. The console has its own session auth
# and is NOT behind the /mcp bearer token. Enabling it also implies a key store.
# AUTH_CONSOLE_ENABLED=true
# AUTH_OIDC_CLIENT_ID=                 # OAuth client for the console (reuses AUTH_OIDC_ISSUER)
# AUTH_OIDC_CLIENT_SECRET=            # confidential-client secret
# AUTH_OIDC_REDIRECT_URI=https://your-host/console/callback   # must match the IdP app config
# AUTH_SESSION_SECRET=                # random secret signing the session cookie (openssl rand -hex 32)
# AUTH_OIDC_SCOPES=openid email profile   # optional; default "openid email profile"
# AUTH_CONSOLE_BASE_PATH=/console     # optional; default /console
# Reuses AUTH_OIDC_ADMIN_GROUPS / _GROUPS_CLAIM / _NAME_CLAIM from the OIDC block
# above: only members of an admin group may mint write-capable keys.

# ---- API-key store -------------------------------------------------------------
# Backing store for console-issued keys. Created when the console is enabled OR
# AUTH_KEY_STORE is set. SQLite is the zero-config default (node:sqlite, no dep).
# AUTH_KEY_STORE=sqlite               # sqlite | postgres | redis (default sqlite)
# AUTH_KEYSTORE_SQLITE_PATH=./udm-keys.db
# AUTH_KEYSTORE_POSTGRES_URL=          # falls back to POSTGRES_URL
# AUTH_KEYSTORE_REDIS_URL=             # falls back to REDIS_URL
