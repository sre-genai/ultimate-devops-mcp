{
  "name": "ultimate-devops-mcp",
  "version": "1.3.0",
  "description": "Production-ready DevOps MCP server (Streamable HTTP) aggregating Grafana, Datadog, Prometheus, Neo4j, MongoDB, Postgres, Elasticsearch, Kafka, Redis and Playwright",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "ultimate-devops-mcp": "dist/index.js",
    "ultimate-devops-mcp-stdio": "dist/stdio.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "dev:stdio": "tsx watch src/stdio.ts",
    "start": "node dist/index.js",
    "start:stdio": "node dist/stdio.js",
    "test": "npm run build && node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@elastic/elasticsearch": "^8.15.0",
    "@kubernetes/client-node": "^1.0.0",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@temporalio/client": "^1.20.2",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "ioredis": "^5.4.1",
    "jose": "^6.2.8",
    "kafkajs": "^2.2.4",
    "ldapts": "^9.0.0",
    "mongodb": "^6.10.0",
    "neo4j-driver": "^5.26.0",
    "pg": "^8.13.0",
    "pino": "^9.5.0",
    "undici": "^6.27.0",
    "zod": "^3.24.1"
  },
  "optionalDependencies": {
    "playwright": "^1.49.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.9.0",
    "@types/pg": "^8.11.10",
    "ldapjs": "^3.0.7",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
