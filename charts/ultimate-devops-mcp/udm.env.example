# -----------------------------------------------------------------------------
# Example env file for the Kubernetes Secret backing the Helm chart.
#
#   cp udm.env.example udm.env      # then fill in real values
#   kubectl create secret generic udm-secrets -n devops --from-env-file=udm.env
#   helm install udm ./charts/ultimate-devops-mcp -n devops \
#     --set existingSecret=udm-secrets
#
# Each KEY becomes a container env var (the chart injects the whole Secret via
# envFrom). Only include the integrations you use — an integration's tools are
# registered only when its vars are present. DO NOT COMMIT the filled-in file.
#
# NOTE: MCP_HTTP_HOST / MCP_HTTP_PORT are managed by the chart — omit them here.
# -----------------------------------------------------------------------------

# ---- Core (REQUIRED) --------------------------------------------------------
# Generate: openssl rand -hex 32
MCP_AUTH_TOKEN=

# ---- Core tuning (optional; can also go in Helm `config:`) -------------------
# MCP_ALLOW_WRITES=false
# MCP_TRUST_PROXY=true
# LOG_LEVEL=info
# MCP_RATE_LIMIT_PER_MINUTE=300
# MCP_ALLOWED_ORIGINS=https://app.example.com

# ---- Postgres ---------------------------------------------------------------
# POSTGRES_URL=postgres://user:pass@postgres:5432/app
# POSTGRES_DB_ALLOW=development,qa,/preprod/i
# POSTGRES_PGBOUNCER=true

# ---- MongoDB ----------------------------------------------------------------
# MONGODB_URI=mongodb://user:pass@mongo:27017

# ---- Neo4j ------------------------------------------------------------------
# NEO4J_URL=bolt://neo4j:7687
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=
# NEO4J_DATABASE=neo4j

# ---- Elasticsearch ----------------------------------------------------------
# ELASTICSEARCH_NODE=https://es:9200
# ELASTICSEARCH_USERNAME=elastic
# ELASTICSEARCH_PASSWORD=
# ELASTICSEARCH_API_KEY=

# ---- Kafka ------------------------------------------------------------------
# KAFKA_BROKERS=kafka:9092
# KAFKA_CLIENT_ID=ultimate-devops-mcp
# KAFKA_SSL=true
# KAFKA_SASL_MECHANISM=scram-sha-512
# KAFKA_SASL_USERNAME=
# KAFKA_SASL_PASSWORD=

# ---- Redis ------------------------------------------------------------------
# REDIS_URL=redis://:pass@redis:6379

# ---- Prometheus -------------------------------------------------------------
# PROMETHEUS_URL=http://prometheus:9090
# PROMETHEUS_BEARER_TOKEN=

# ---- Grafana (single, or multi-instance prod/non-prod) ----------------------
# GRAFANA_URL=https://grafana.example.com
# GRAFANA_TOKEN=
# GRAFANA_API_KEY=
# Multi-instance: declare names, then a URL+TOKEN pair each. Tools take an
# optional `instance` arg (default: first listed, or GRAFANA_PRIMARY).
# GRAFANA_INSTANCES=prod,nonprod
# GRAFANA_PROD_URL=https://grafana.prod.example.com
# GRAFANA_PROD_TOKEN=
# GRAFANA_NONPROD_URL=https://grafana.staging.example.com
# GRAFANA_NONPROD_TOKEN=
# GRAFANA_PRIMARY=prod

# ---- Datadog ----------------------------------------------------------------
# DATADOG_API_KEY=
# DATADOG_APP_KEY=
# DATADOG_SITE=datadoghq.com

# ---- ArgoCD -----------------------------------------------------------------
# ARGOCD_URL=https://argocd.example.com
# ARGOCD_TOKEN=

# ---- GitLab -----------------------------------------------------------------
# GITLAB_URL=https://gitlab.com
# GITLAB_TOKEN=

# ---- GitHub -----------------------------------------------------------------
# GITHUB_TOKEN=
# GITHUB_API_URL=https://api.github.com

# ---- Bitbucket --------------------------------------------------------------
# BITBUCKET_WORKSPACE=
# BITBUCKET_USERNAME=
# BITBUCKET_TOKEN=
# BITBUCKET_APP_PASSWORD=
# BITBUCKET_API_URL=https://api.bitbucket.org/2.0

# ---- Temporal ---------------------------------------------------------------
# TEMPORAL_ADDRESS=temporal:7233
# TEMPORAL_NAMESPACE=default
# TEMPORAL_API_KEY=
# TEMPORAL_TLS=true
# TEMPORAL_TLS_CERT=
# TEMPORAL_TLS_KEY=
# TEMPORAL_TLS_CA=
# TEMPORAL_TLS_SERVER_NAME=

# ---- Kubernetes (in-cluster) ------------------------------------------------
# Use rbac.create=true in Helm values instead of a kubeconfig for in-cluster access.
# K8S_ENABLED=true

# ---- Playwright (needs the WITH_BROWSER image variant) ----------------------
# PLAYWRIGHT_ENABLED=true
